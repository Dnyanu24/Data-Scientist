# Application
APP_NAME=AI Data Scientist
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_datascientist
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ai_datascientist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_datascientist
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Configuration (choose one provider)
LLM_PROVIDER=openai
# Options: openai, gemini, local

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

# Local LLM
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama2

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlruns

# Storage
UPLOAD_DIR=./uploads
MODEL_STORE_DIR=./model_store

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
